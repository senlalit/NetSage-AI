 .venv\Scripts\python.exe -m streamlit run app.py<?xml version="1.0" encoding="UTF-8"?>
<!-- NetSage AI Enterprise Lab Topology & Configuration Specification -->
<!-- Created for Cisco Packet Tracer Network Diagnostics & NetSage AI Benchmark -->
<PACKETTRACER_LAB name="NetSage_AI_Enterprise_Lab" version="8.2">
  <TOPOLOGY>
    <DEVICES>
      <DEVICE id="R1" type="Router" model="2911" x="250" y="100">
        <INTERFACES>
          <INTERFACE name="GigabitEthernet0/0" status="up" trunk="802.1Q">
            <SUBINTERFACE id="GigabitEthernet0/0.10" vlan="10" ip="192.168.10.1" mask="255.255.255.0"/>
            <SUBINTERFACE id="GigabitEthernet0/0.20" vlan="20" ip="192.168.20.1" mask="255.255.255.0"/>
            <SUBINTERFACE id="GigabitEthernet0/0.30" vlan="30" ip="192.168.30.1" mask="255.255.255.0"/>
            <SUBINTERFACE id="GigabitEthernet0/0.40" vlan="40" ip="192.168.40.1" mask="255.255.255.0"/>
          </INTERFACE>
          <INTERFACE name="GigabitEthernet0/1" ip="10.0.0.1" mask="255.255.255.252" status="up" ospf_area="0"/>
        </INTERFACES>
        <STARTUP_CONFIG>
!
hostname R1
no ip domain-lookup
!
interface GigabitEthernet0/0
 no ip address
 no shutdown
!
interface GigabitEthernet0/0.10
 encapsulation dot1Q 10
 ip address 192.168.10.1 255.255.255.0
 no shutdown
!
interface GigabitEthernet0/0.20
 encapsulation dot1Q 20
 ip address 192.168.20.1 255.255.255.0
 no shutdown
!
interface GigabitEthernet0/0.30
 encapsulation dot1Q 30
 ip address 192.168.30.1 255.255.255.0
 no shutdown
!
interface GigabitEthernet0/0.40
 encapsulation dot1Q 40
 ip address 192.168.40.1 255.255.255.0
 no shutdown
!
interface GigabitEthernet0/1
 ip address 10.0.0.1 255.255.255.252
 ip ospf hello-interval 10
 ip ospf dead-interval 40
 no shutdown
!
ip dhcp excluded-address 192.168.10.1 192.168.10.10
ip dhcp excluded-address 192.168.20.1 192.168.20.10
!
ip dhcp pool VLAN10_POOL
 network 192.168.10.0 255.255.255.0
 default-router 192.168.10.1
 dns-server 10.0.0.10
!
ip dhcp pool VLAN20_POOL
 network 192.168.20.0 255.255.255.0
 default-router 192.168.20.1
 dns-server 10.0.0.10
!
router ospf 1
 router-id 1.1.1.1
 network 192.168.10.0 0.0.0.255 area 0
 network 192.168.20.0 0.0.0.255 area 0
 network 192.168.30.0 0.0.0.255 area 0
 network 192.168.40.0 0.0.0.255 area 0
 network 10.0.0.0 0.0.0.3 area 0
!
access-list 1 permit 192.168.0.0 0.0.255.255
ip nat inside source list 1 interface GigabitEthernet0/1 overload
cdp run
!
        </STARTUP_CONFIG>
      </DEVICE>

      <DEVICE id="R2" type="Router" model="2911" x="550" y="100">
        <INTERFACES>
          <INTERFACE name="GigabitEthernet0/0" ip="10.0.0.2" mask="255.255.255.252" status="up" ospf_area="0"/>
          <INTERFACE name="GigabitEthernet0/1" ip="10.0.0.129" mask="255.255.255.128" status="up" ospf_area="0"/>
        </INTERFACES>
        <STARTUP_CONFIG>
!
hostname R2
no ip domain-lookup
!
interface GigabitEthernet0/0
 ip address 10.0.0.2 255.255.255.252
 ip ospf hello-interval 10
 ip ospf dead-interval 40
 no shutdown
!
interface GigabitEthernet0/1
 ip address 10.0.0.129 255.255.255.128
 no shutdown
!
router ospf 1
 router-id 2.2.2.2
 network 10.0.0.0 0.0.0.3 area 0
 network 10.0.0.128 0.0.0.127 area 0
!
cdp run
!
        </STARTUP_CONFIG>
      </DEVICE>

      <DEVICE id="SW1" type="Switch" model="2960" x="250" y="280">
        <STARTUP_CONFIG>
!
hostname SW1
no ip domain-lookup
!
vlan 10
 name Sales
vlan 20
 name Engineering
vlan 30
 name Servers
vlan 40
 name Finance
vlan 99
 name Management
!
interface GigabitEthernet0/1
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,40,99
 no shutdown
!
interface FastEthernet0/24
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,40,99
 no shutdown
!
interface FastEthernet0/1
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 no shutdown
!
interface FastEthernet0/2
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
 no shutdown
!
interface FastEthernet0/10
 switchport mode access
 switchport access vlan 40
 spanning-tree portfast
 no shutdown
!
interface Vlan99
 ip address 192.168.99.2 255.255.255.0
 no shutdown
!
ip default-gateway 192.168.99.1
cdp run
!
        </STARTUP_CONFIG>
      </DEVICE>

      <DEVICE id="SW2" type="Switch" model="2960" x="450" y="280">
        <STARTUP_CONFIG>
!
hostname SW2
no ip domain-lookup
!
vlan 10
 name Sales
vlan 20
 name Engineering
vlan 30
 name Servers
vlan 40
 name Finance
vlan 99
 name Management
!
interface FastEthernet0/24
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,40,99
 no shutdown
!
interface FastEthernet0/5
 switchport mode access
 switchport access vlan 30
 spanning-tree portfast
 no shutdown
!
interface Vlan99
 ip address 192.168.99.3 255.255.255.0
 no shutdown
!
ip default-gateway 192.168.99.1
cdp run
!
        </STARTUP_CONFIG>
      </DEVICE>

      <DEVICE id="PC1" type="PC" x="150" y="420" vlan="10" ip="192.168.10.50" gateway="192.168.10.1"/>
      <DEVICE id="PC2" type="PC" x="250" y="420" vlan="20" ip="192.168.20.50" gateway="192.168.20.1"/>
      <DEVICE id="Finance_PC" type="PC" x="350" y="420" vlan="40" ip="192.168.40.50" gateway="192.168.40.1"/>
      <DEVICE id="Server1" type="Server" x="450" y="420" vlan="30" ip="192.168.30.10" gateway="192.168.30.1"/>
      <DEVICE id="Remote_Server" type="Server" x="550" y="280" ip="10.0.0.130" gateway="10.0.0.129"/>
    </DEVICES>

    <LINKS>
      <LINK from="R1:GigabitEthernet0/0" to="SW1:GigabitEthernet0/1" type="CopperStraightThrough"/>
      <LINK from="R1:GigabitEthernet0/1" to="R2:GigabitEthernet0/0" type="CopperCrossOver"/>
      <LINK from="SW1:FastEthernet0/24" to="SW2:FastEthernet0/24" type="CopperCrossOver"/>
      <LINK from="SW1:FastEthernet0/1" to="PC1:FastEthernet0" type="CopperStraightThrough"/>
      <LINK from="SW1:FastEthernet0/2" to="PC2:FastEthernet0" type="CopperStraightThrough"/>
      <LINK from="SW1:FastEthernet0/10" to="Finance_PC:FastEthernet0" type="CopperStraightThrough"/>
      <LINK from="SW2:FastEthernet0/5" to="Server1:FastEthernet0" type="CopperStraightThrough"/>
      <LINK from="R2:GigabitEthernet0/1" to="Remote_Server:FastEthernet0" type="CopperStraightThrough"/>
    </LINKS>
  </TOPOLOGY>
</PACKETTRACER_LAB>
